# Data & artifacts — NEVER push competition data or built indexes
# (anchored to the repo root — a bare "data/" would also ignore src/cvf/data/!)
# "/data/*" not "/data/": excluding the DIRECTORY itself would make the
# .gitkeep re-include below ineffective (git cannot re-include a file whose
# parent directory is excluded), so the folder skeleton would never commit.
/data/*
!/data/.gitkeep
/artifacts/
/outputs/
*.faiss
*.npy
*.npz
*.parquet
*.index

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Secrets
.env
*.key
secrets*.yaml

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
logs/
wandb/
runs/tb/
